{
  "entities": {
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated PII document storing a user's full name, email, date of birth, gender, and unique Sri Lankan NIC number.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the account owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full legal name of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Public display name chosen by the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Account email address."
        },
        "dateOfBirth": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "ISO date of birth (YYYY-MM-DD), verified 18+."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "non_binary", "prefer_not_to_say"],
          "minLength": 4,
          "maxLength": 20,
          "description": "User gender identity."
        },
        "nicNumber": {
          "type": "string",
          "pattern": "^([0-9]{9}[VX]|[0-9]{12})$",
          "minLength": 10,
          "maxLength": 12,
          "description": "Normalized Sri Lankan National Identity Card (NIC) number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "userId",
        "name",
        "displayName",
        "email",
        "dateOfBirth",
        "gender",
        "nicNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "NicRegistryEntry": {
      "title": "NicRegistryEntry",
      "description": "Unique index lock ensuring one Sri Lankan NIC number can only ever be used by one account.",
      "type": "object",
      "properties": {
        "nicNumber": {
          "type": "string",
          "pattern": "^([0-9]{9}[VX]|[0-9]{12})$",
          "minLength": 10,
          "maxLength": 12,
          "description": "Normalized Sri Lankan NIC number matching the document ID."
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID that claimed this NIC number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the NIC was claimed."
        }
      },
      "required": ["nicNumber", "ownerId", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII profile document for discovery and onboarding preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the profile owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Public display name."
        },
        "age": {
          "type": "number",
          "description": "Calculated age (18 to 120)."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "non_binary", "prefer_not_to_say"],
          "minLength": 4,
          "maxLength": 20,
          "description": "User gender."
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Avatar URL or preset path."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short biography."
        },
        "region": {
          "type": "string",
          "maxLength": 60,
          "description": "General region in Sri Lanka."
        },
        "showRegion": {
          "type": "boolean",
          "description": "Whether region is visible."
        },
        "datingIntention": {
          "type": "string",
          "enum": [
            "long_term_story",
            "meaningful_dating",
            "new_conversations",
            "friendship_first"
          ],
          "description": "Dating intention."
        },
        "spokenLanguages": {
          "type": "array",
          "description": "Spoken languages (up to 5 strings)."
        },
        "interestIds": {
          "type": "array",
          "description": "Selected interest IDs (up to 6 strings)."
        },
        "discoverable": {
          "type": "boolean",
          "description": "Whether profile is discoverable."
        },
        "allowRandomVideo": {
          "type": "boolean",
          "description": "Whether user allows random video chat."
        },
        "allowRandomText": {
          "type": "boolean",
          "description": "Whether user allows random text chat."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether onboarding steps are complete."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "si", "ta"],
          "description": "Preferred UI language."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "userId",
        "displayName",
        "age",
        "gender",
        "avatarUrl",
        "bio",
        "region",
        "showRegion",
        "datingIntention",
        "spokenLanguages",
        "interestIds",
        "discoverable",
        "allowRandomVideo",
        "allowRandomText",
        "onboardingCompleted",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII public profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Strictly owner-isolated PII document (docId == 'account') holding name, email, dateOfBirth, gender, and nicNumber."
    },
    "/nic_registry/{nicId}": {
      "schema": { "$ref": "#/entities/NicRegistryEntry" },
      "description": "Immutable Sri Lankan NIC uniqueness registry preventing duplicate NIC sign-ups across accounts."
    }
  }
}
