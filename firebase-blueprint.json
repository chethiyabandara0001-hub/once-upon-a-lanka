{
  "entities": {
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated PII document storing a user's full name, email, dateOfBirth, gender, and unique Sri Lankan NIC number.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the account owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full legal name of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Public display name chosen by the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Account email address."
        },
        "dateOfBirth": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "ISO date of birth (YYYY-MM-DD), verified 18+."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "non_binary", "prefer_not_to_say"],
          "minLength": 4,
          "maxLength": 20,
          "description": "User gender identity."
        },
        "nicNumber": {
          "type": "string",
          "pattern": "^([0-9]{9}[VX]|[0-9]{12})$",
          "minLength": 10,
          "maxLength": 12,
          "description": "Normalized Sri Lankan National Identity Card (NIC) number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "userId",
        "name",
        "displayName",
        "email",
        "dateOfBirth",
        "gender",
        "nicNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "NicRegistryEntry": {
      "title": "NicRegistryEntry",
      "description": "Unique index lock ensuring one Sri Lankan NIC number can only ever be used by one account.",
      "type": "object",
      "properties": {
        "nicNumber": {
          "type": "string",
          "pattern": "^([0-9]{9}[VX]|[0-9]{12})$",
          "minLength": 10,
          "maxLength": 12,
          "description": "Normalized Sri Lankan NIC number matching the document ID."
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID that claimed this NIC number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the NIC was claimed."
        }
      },
      "required": ["nicNumber", "ownerId", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII profile document for discovery and onboarding preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the profile owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Public display name."
        },
        "age": {
          "type": "number",
          "description": "Calculated age (18 to 120)."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "non_binary", "prefer_not_to_say"],
          "minLength": 4,
          "maxLength": 20,
          "description": "User gender."
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Avatar URL or preset path."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short biography."
        },
        "region": {
          "type": "string",
          "maxLength": 60,
          "description": "General region in Sri Lanka."
        },
        "showRegion": {
          "type": "boolean",
          "description": "Whether region is visible."
        },
        "datingIntention": {
          "type": "string",
          "enum": [
            "long_term_story",
            "meaningful_dating",
            "new_conversations",
            "friendship_first"
          ],
          "description": "Dating intention."
        },
        "spokenLanguages": {
          "type": "array",
          "description": "Spoken languages (up to 5 strings)."
        },
        "interestIds": {
          "type": "array",
          "description": "Selected interest IDs (up to 6 strings)."
        },
        "discoverable": {
          "type": "boolean",
          "description": "Whether profile is discoverable."
        },
        "allowRandomVideo": {
          "type": "boolean",
          "description": "Whether user allows random video chat."
        },
        "allowRandomText": {
          "type": "boolean",
          "description": "Whether user allows random text chat."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether onboarding steps are complete."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "si", "ta"],
          "description": "Preferred UI language."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "userId",
        "displayName",
        "age",
        "gender",
        "avatarUrl",
        "bio",
        "region",
        "showRegion",
        "datingIntention",
        "spokenLanguages",
        "interestIds",
        "discoverable",
        "allowRandomVideo",
        "allowRandomText",
        "onboardingCompleted",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    },
    "MatchmakingQueueEntry": {
      "title": "MatchmakingQueueEntry",
      "description": "Active real user waiting in the spontaneous matchmaking queue.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID of the waiting participant."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Display name of waiting user."
        },
        "region": {
          "type": "string",
          "maxLength": 60,
          "description": "User region."
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "matched", "cancelled"],
          "description": "Current status in the matchmaking queue."
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of paired matchmaking session once matched."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user joined queue."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last queue update or heartbeat."
        }
      },
      "required": ["userId", "displayName", "status", "createdAt", "updatedAt"]
    },
    "MatchmakingSession": {
      "title": "MatchmakingSession",
      "description": "A live random session between two real authenticated users.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique session ID."
        },
        "participants": {
          "type": "array",
          "description": "List of user IDs in this session."
        },
        "userAId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID of first participant."
        },
        "userBId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID of second participant."
        },
        "userAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name of first participant."
        },
        "userBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name of second participant."
        },
        "userARegion": {
          "type": "string",
          "maxLength": 60,
          "description": "Region of first participant."
        },
        "userBRegion": {
          "type": "string",
          "maxLength": 60,
          "description": "Region of second participant."
        },
        "status": {
          "type": "string",
          "enum": ["active", "ended"],
          "description": "Session active state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when session began."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last state change."
        }
      },
      "required": ["sessionId", "participants", "userAId", "userBId", "status", "createdAt", "updatedAt"]
    },
    "SessionMessage": {
      "title": "SessionMessage",
      "description": "Ephemeral message sent inside a matchmaking session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Message document ID."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Parent session ID."
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Sender user ID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Sender display name."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Message text content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of message creation."
        }
      },
      "required": ["id", "sessionId", "senderId", "senderName", "text", "createdAt"]
    },
    "VideoSignalingSession": {
      "title": "VideoSignalingSession",
      "description": "WebRTC SDP signaling state scoped to an authenticated matchmaking session.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Matches the parent matchmaking session ID."
        },
        "initiatorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Designated WebRTC offerer UID."
        },
        "answererId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Designated WebRTC answerer UID."
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "negotiating", "connected", "ended"],
          "description": "Signaling lifecycle state."
        },
        "initiatorReady": {
          "type": "boolean",
          "description": "Whether initiator has granted camera/mic and joined video."
        },
        "answererReady": {
          "type": "boolean",
          "description": "Whether answerer has granted camera/mic and joined video."
        },
        "offerType": {
          "type": "string",
          "maxLength": 20,
          "description": "SDP offer type ('offer' or empty)."
        },
        "offerSdp": {
          "type": "string",
          "maxLength": 24000,
          "description": "Raw SDP offer string."
        },
        "answerType": {
          "type": "string",
          "maxLength": 20,
          "description": "SDP answer type ('answer' or empty)."
        },
        "answerSdp": {
          "type": "string",
          "maxLength": 24000,
          "description": "Raw SDP answer string."
        },
        "offerRevision": {
          "type": "number",
          "description": "Monotonic counter for initial offer and ICE restarts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "sessionId",
        "initiatorId",
        "answererId",
        "status",
        "initiatorReady",
        "answererReady",
        "offerType",
        "offerSdp",
        "answerType",
        "answerSdp",
        "offerRevision",
        "createdAt",
        "updatedAt"
      ]
    },
    "WebRtcIceCandidate": {
      "title": "WebRtcIceCandidate",
      "description": "ICE candidate published by an authenticated participant during WebRTC signaling.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique candidate document ID."
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Session ID."
        },
        "senderId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Participant UID who generated this candidate."
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Serialized RTCIceCandidate string."
        },
        "sdpMid": {
          "type": "string",
          "maxLength": 64,
          "description": "Media stream identification tag."
        },
        "sdpMLineIndex": {
          "type": "number",
          "description": "Zero-based m-line index in SDP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "sessionId", "senderId", "candidate", "sdpMid", "sdpMLineIndex", "createdAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "User block record preventing matching and direct contact.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 260,
          "description": "Document ID matching blockerId_blockedUserId."
        },
        "blockerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID who initiated the block."
        },
        "blockedUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID who is blocked."
        },
        "blockedDisplayName": {
          "type": "string",
          "maxLength": 50,
          "description": "Display name of blocked user."
        },
        "reason": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional reason for block."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when block was created."
        }
      },
      "required": ["id", "blockerId", "blockedUserId", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Safety report submitted by a user for moderation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Report ID."
        },
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID of reporter."
        },
        "reportedUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "User ID being reported."
        },
        "contextType": {
          "type": "string",
          "enum": ["random_video", "random_text", "profile", "direct_message"],
          "description": "Context of report."
        },
        "reason": {
          "type": "string",
          "maxLength": 50,
          "description": "Report category code."
        },
        "details": {
          "type": "string",
          "maxLength": 1000,
          "description": "Report explanation."
        },
        "status": {
          "type": "string",
          "enum": ["open", "investigating", "resolved", "dismissed"],
          "description": "Moderation status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of submission."
        }
      },
      "required": ["id", "reporterId", "reportedUserId", "contextType", "reason", "status", "createdAt"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Standard 30-day membership record for adult members.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Subscriber User ID."
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "expired"],
          "description": "Subscription status."
        },
        "plan": {
          "type": "string",
          "enum": ["standard_30d", "free_trial"],
          "description": "Plan tier identifier."
        },
        "amount": {
          "type": "number",
          "description": "Amount in LKR (e.g. 500)."
        },
        "currency": {
          "type": "string",
          "enum": ["LKR"],
          "description": "Currency code."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiry timestamp."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["userId", "status", "plan", "amount", "currency", "expiresAt", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII public profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Strictly owner-isolated PII document (docId == 'account') holding name, email, dateOfBirth, gender, and nicNumber."
    },
    "/nic_registry/{nicId}": {
      "schema": { "$ref": "#/entities/NicRegistryEntry" },
      "description": "Immutable Sri Lankan NIC uniqueness registry preventing duplicate NIC sign-ups across accounts."
    },
    "/matchmaking_queue/{userId}": {
      "schema": { "$ref": "#/entities/MatchmakingQueueEntry" },
      "description": "Live matchmaking queue containing real authenticated users waiting for spontaneous video/text chat."
    },
    "/matchmaking_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/MatchmakingSession" },
      "description": "Active paired random chat sessions between two authenticated participants."
    },
    "/matchmaking_sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SessionMessage" },
      "description": "Ephemeral real-time chat messages exchanged between participants during a matchmaking session."
    },
    "/videoSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/VideoSignalingSession" },
      "description": "Session-scoped WebRTC SDP offer/answer and readiness signaling document."
    },
    "/videoSessions/{sessionId}/initiatorCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/WebRtcIceCandidate" },
      "description": "ICE candidates generated by the designated WebRTC offer initiator."
    },
    "/videoSessions/{sessionId}/answererCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/WebRtcIceCandidate" },
      "description": "ICE candidates generated by the designated WebRTC answerer."
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Safety block records preventing pairing and messaging between users."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User-submitted safety reports for Trust & Safety moderation."
    },
    "/subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/SubscriptionRecord" },
      "description": "Membership subscription records."
    }
  }
}
