rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNicId(nicId) {
      return nicId is string && nicId.size() >= 10 && nicId.size() <= 12 && nicId.matches('^([0-9]{9}[VX]|[0-9]{12})$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints (Pillar 2 & Pillar 5)
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
        data.age is int && data.age >= 18 && data.age <= 120 &&
        data.gender is string && data.gender.size() >= 4 && data.gender.size() <= 20 &&
        data.gender in ['male', 'female', 'non_binary', 'prefer_not_to_say'] &&
        data.avatarUrl is string && data.avatarUrl.size() >= 1 && data.avatarUrl.size() <= 2048 &&
        data.bio is string && data.bio.size() <= 500 &&
        data.region is string && data.region.size() <= 60 &&
        data.showRegion is bool &&
        data.datingIntention is string && data.datingIntention.size() <= 30 &&
        data.datingIntention in ['long_term_story', 'meaningful_dating', 'new_conversations', 'friendship_first'] &&
        data.spokenLanguages is list && data.spokenLanguages.size() >= 1 && data.spokenLanguages.size() <= 5 &&
        data.spokenLanguages[0] is string && data.spokenLanguages[0].size() >= 2 && data.spokenLanguages[0].size() <= 30 &&
        data.interestIds is list && data.interestIds.size() >= 1 && data.interestIds.size() <= 6 &&
        data.interestIds[0] is string && data.interestIds[0].size() >= 2 && data.interestIds[0].size() <= 40 &&
        data.discoverable is bool &&
        data.allowRandomVideo is bool &&
        data.allowRandomText is bool &&
        data.onboardingCompleted is bool &&
        data.preferredLanguage is string && data.preferredLanguage.size() == 2 &&
        data.preferredLanguage in ['en', 'si', 'ta'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateAccount(data, userId) {
      return data.keys().hasAll([
          'userId',
          'name',
          'displayName',
          'email',
          'dateOfBirth',
          'gender',
          'nicNumber',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'name',
          'displayName',
          'email',
          'dateOfBirth',
          'gender',
          'nicNumber',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId && data.userId == request.auth.uid &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.dateOfBirth is string && data.dateOfBirth.size() == 10 &&
        data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.gender is string && data.gender.size() >= 4 && data.gender.size() <= 20 &&
        data.gender in ['male', 'female', 'non_binary', 'prefer_not_to_say'] &&
        data.nicNumber is string && isValidNicId(data.nicNumber) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNicRegistryEntry(data, nicId) {
      return data.keys().hasAll(['nicNumber', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['nicNumber', 'ownerId', 'createdAt']) &&
        data.nicNumber is string && isValidNicId(data.nicNumber) &&
        data.nicNumber == nicId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules: /users/{userId} (Non-PII Public Profile)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) || existing().discoverable == true
      );

      allow list: if isSignedIn() && existing().discoverable == true;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(userId)/private/account);

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'updatedAt'
        ]);

      allow delete: if false;

      // 5. Subcollection Rules: /users/{userId}/private/{docId} (Strictly Isolated PII)
      match /private/{docId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateAccount(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid &&
          existsAfter(/databases/$(database)/documents/nic_registry/$(incoming().nicNumber)) &&
          getAfter(/databases/$(database)/documents/nic_registry/$(incoming().nicNumber)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateAccount(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().nicNumber == existing().nicNumber &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'displayName',
            'dateOfBirth',
            'gender',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow delete: if false;
      }
    }

    // 6. Collection Rules: /nic_registry/{nicId} (One Sri Lankan NIC Per Account Lock)
    match /nic_registry/{nicId} {
      // Allow authenticated user to check if a NIC is already registered before/during sign-up
      allow get: if isSignedIn() && isValidNicId(nicId);

      allow list: if false;

      // Only allow creating a NIC lock if it does not already exist AND the user atomically creates their private account with that exact NIC
      allow create: if isVerifiedUser() &&
        isValidNicId(nicId) &&
        isValidNicRegistryEntry(incoming(), nicId) &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/account) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/account).data.nicNumber == nicId;

      allow update, delete: if false;
    }
  }
}
