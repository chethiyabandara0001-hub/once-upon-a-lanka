rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBlockId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNicId(nicId) {
      return nicId is string && nicId.size() >= 10 && nicId.size() <= 12 && nicId.matches('^([0-9]{9}[VX]|[0-9]{12})$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
        data.age is int && data.age >= 18 && data.age <= 120 &&
        data.gender is string && data.gender.size() >= 4 && data.gender.size() <= 20 &&
        data.gender in ['male', 'female', 'non_binary', 'prefer_not_to_say'] &&
        data.avatarUrl is string && data.avatarUrl.size() >= 1 && data.avatarUrl.size() <= 2048 &&
        data.bio is string && data.bio.size() <= 500 &&
        data.region is string && data.region.size() <= 60 &&
        data.showRegion is bool &&
        data.datingIntention is string && data.datingIntention.size() <= 30 &&
        data.datingIntention in ['long_term_story', 'meaningful_dating', 'new_conversations', 'friendship_first'] &&
        data.spokenLanguages is list && data.spokenLanguages.size() >= 1 && data.spokenLanguages.size() <= 5 &&
        data.spokenLanguages[0] is string && data.spokenLanguages[0].size() >= 2 && data.spokenLanguages[0].size() <= 30 &&
        data.interestIds is list && data.interestIds.size() >= 1 && data.interestIds.size() <= 6 &&
        data.interestIds[0] is string && data.interestIds[0].size() >= 2 && data.interestIds[0].size() <= 40 &&
        data.discoverable is bool &&
        data.allowRandomVideo is bool &&
        data.allowRandomText is bool &&
        data.onboardingCompleted is bool &&
        data.preferredLanguage is string && data.preferredLanguage.size() == 2 &&
        data.preferredLanguage in ['en', 'si', 'ta'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateAccount(data, userId) {
      return data.keys().hasAll([
          'userId',
          'name',
          'displayName',
          'email',
          'dateOfBirth',
          'gender',
          'nicNumber',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'name',
          'displayName',
          'email',
          'dateOfBirth',
          'gender',
          'nicNumber',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId && data.userId == request.auth.uid &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.dateOfBirth is string && data.dateOfBirth.size() == 10 &&
        data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.gender is string && data.gender.size() >= 4 && data.gender.size() <= 20 &&
        data.gender in ['male', 'female', 'non_binary', 'prefer_not_to_say'] &&
        data.nicNumber is string && isValidNicId(data.nicNumber) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNicRegistryEntry(data, nicId) {
      return data.keys().hasAll(['nicNumber', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['nicNumber', 'ownerId', 'createdAt']) &&
        data.nicNumber is string && isValidNicId(data.nicNumber) &&
        data.nicNumber == nicId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidQueueEntry(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
        data.status in ['waiting', 'matched', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSession(data, sessionId) {
      return data.keys().hasAll(['sessionId', 'participants', 'userAId', 'userBId', 'status', 'createdAt', 'updatedAt']) &&
        data.sessionId is string && data.sessionId == sessionId &&
        data.participants is list && data.participants.size() == 2 &&
        data.userAId is string && data.userAId.size() <= 128 &&
        data.userBId is string && data.userBId.size() <= 128 &&
        data.userAId != data.userBId &&
        data.status in ['active', 'ended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSessionMessage(data) {
      return data.keys().hasAll(['id', 'sessionId', 'senderId', 'senderName', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.senderId is string && data.senderId == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 50 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidVideoSignalingSession(data, sessionId) {
      return data.keys().hasAll([
          'sessionId',
          'initiatorId',
          'answererId',
          'status',
          'initiatorReady',
          'answererReady',
          'offerType',
          'offerSdp',
          'answerType',
          'answerSdp',
          'offerRevision',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sessionId',
          'initiatorId',
          'answererId',
          'status',
          'initiatorReady',
          'answererReady',
          'offerType',
          'offerSdp',
          'answerType',
          'answerSdp',
          'offerRevision',
          'createdAt',
          'updatedAt'
        ]) &&
        data.sessionId is string && data.sessionId == sessionId &&
        data.initiatorId is string && data.initiatorId.size() >= 1 && data.initiatorId.size() <= 128 &&
        data.answererId is string && data.answererId.size() >= 1 && data.answererId.size() <= 128 &&
        data.initiatorId != data.answererId &&
        data.status is string && data.status in ['waiting', 'negotiating', 'connected', 'ended'] &&
        data.initiatorReady is bool &&
        data.answererReady is bool &&
        data.offerType is string && data.offerType.size() <= 20 &&
        data.offerSdp is string && data.offerSdp.size() <= 24000 &&
        data.answerType is string && data.answerType.size() <= 20 &&
        data.answerSdp is string && data.answerSdp.size() <= 24000 &&
        data.offerRevision is int && data.offerRevision >= 0 && data.offerRevision <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIceCandidate(data, sessionId, candidateId) {
      return data.keys().hasAll([
          'id',
          'sessionId',
          'senderId',
          'candidate',
          'sdpMid',
          'sdpMLineIndex',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'sessionId',
          'senderId',
          'candidate',
          'sdpMid',
          'sdpMLineIndex',
          'createdAt'
        ]) &&
        data.id is string && data.id == candidateId &&
        data.sessionId is string && data.sessionId == sessionId &&
        data.senderId is string && data.senderId == request.auth.uid &&
        data.candidate is string && data.candidate.size() >= 1 && data.candidate.size() <= 2048 &&
        data.sdpMid is string && data.sdpMid.size() <= 64 &&
        data.sdpMLineIndex is int && data.sdpMLineIndex >= 0 && data.sdpMLineIndex <= 32 &&
        data.createdAt is timestamp;
    }

    function isValidBlock(data, blockId) {
      return data.keys().hasAll(['id', 'blockerId', 'blockedUserId', 'createdAt']) &&
        data.id is string && data.id == blockId &&
        data.blockerId is string && data.blockerId == request.auth.uid &&
        data.blockedUserId is string && data.blockedUserId.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['id', 'reporterId', 'reportedUserId', 'contextType', 'reason', 'status', 'createdAt']) &&
        data.id is string && data.id == reportId &&
        data.reporterId is string && data.reporterId == request.auth.uid &&
        data.reportedUserId is string && data.reportedUserId.size() <= 128 &&
        data.contextType in ['random_video', 'random_text', 'profile', 'direct_message'] &&
        data.status in ['open', 'investigating', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) || (resource != null && existing().discoverable == true)
      );

      allow list: if isSignedIn() && existing().discoverable == true;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(userId)/private/account);

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'age',
          'gender',
          'avatarUrl',
          'bio',
          'region',
          'showRegion',
          'datingIntention',
          'spokenLanguages',
          'interestIds',
          'discoverable',
          'allowRandomVideo',
          'allowRandomText',
          'onboardingCompleted',
          'preferredLanguage',
          'updatedAt'
        ]);

      allow delete: if false;

      // 5. Subcollection Rules: /users/{userId}/private/{docId}
      match /private/{docId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) && (
            resource == null || (
              exists(/databases/$(database)/documents/users/$(userId)) &&
              get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid
            )
          );

        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateAccount(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid &&
          existsAfter(/databases/$(database)/documents/nic_registry/$(incoming().nicNumber)) &&
          getAfter(/databases/$(database)/documents/nic_registry/$(incoming().nicNumber)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateAccount(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().nicNumber == existing().nicNumber &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'displayName',
            'dateOfBirth',
            'gender',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow delete: if false;
      }
    }

    // 6. Collection Rules: /nic_registry/{nicId}
    match /nic_registry/{nicId} {
      allow get: if isSignedIn() && isValidNicId(nicId);

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidNicId(nicId) &&
        isValidNicRegistryEntry(incoming(), nicId) &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/account) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/account).data.nicNumber == nicId;

      allow update, delete: if false;
    }

    // 7. Collection Rules: /matchmaking_queue/{userId}
    match /matchmaking_queue/{userId} {
      allow get: if isSignedIn() && isValidId(userId);

      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidQueueEntry(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidQueueEntry(incoming(), userId) &&
        incoming().updatedAt == request.time && (
          isOwner(userId) || (
            existing().status == 'waiting' &&
            incoming().status == 'matched' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sessionId', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // 8. Collection Rules: /matchmaking_sessions/{sessionId}
    match /matchmaking_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (
        existing().userAId == request.auth.uid ||
        existing().userBId == request.auth.uid
      );

      allow list: if isSignedIn() && (
        resource.data.userAId == request.auth.uid ||
        resource.data.userBId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidSession(incoming(), sessionId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          incoming().userAId == request.auth.uid ||
          incoming().userBId == request.auth.uid
        );

      allow update: if isSignedIn() &&
        isValidId(sessionId) &&
        incoming().updatedAt == request.time && (
          existing().userAId == request.auth.uid ||
          existing().userBId == request.auth.uid
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;

      // Ephemeral Session Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(sessionId) && (
          get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userAId == request.auth.uid ||
          get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userBId == request.auth.uid
        );

        allow create: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidSessionMessage(incoming()) &&
          incoming().sessionId == sessionId &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time && (
            get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userAId == request.auth.uid ||
            get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userBId == request.auth.uid
          );

        allow update, delete: if false;
      }
    }

    // 9. Collection Rules: /videoSessions/{sessionId} (WebRTC SDP & ICE Signaling)
    match /videoSessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (
        resource == null ||
        existing().initiatorId == request.auth.uid ||
        existing().answererId == request.auth.uid
      );

      allow list: if false;

      // Only authenticated participants of an active matchmaking_session can initialize its videoSession
      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidVideoSignalingSession(incoming(), sessionId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().initiatorId == request.auth.uid || incoming().answererId == request.auth.uid) &&
        exists(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.status == 'active' &&
        get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userAId == incoming().initiatorId &&
        get(/databases/$(database)/documents/matchmaking_sessions/$(sessionId)).data.userBId == incoming().answererId;

      allow update: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidVideoSignalingSession(incoming(), sessionId) &&
        existing().status != 'ended' &&
        incoming().sessionId == existing().sessionId &&
        incoming().initiatorId == existing().initiatorId &&
        incoming().answererId == existing().answererId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Initiator publishes readiness, SDP offer, or ICE restart offer
          (
            request.auth.uid == existing().initiatorId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'initiatorReady',
              'offerType',
              'offerSdp',
              'answerType',
              'answerSdp',
              'offerRevision',
              'status',
              'updatedAt'
            ])
          ) ||
          // Action 2: Answerer publishes readiness or SDP answer
          (
            request.auth.uid == existing().answererId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'answererReady',
              'answerType',
              'answerSdp',
              'status',
              'updatedAt'
            ])
          ) ||
          // Action 3: Either participant ends the video call
          (
            (request.auth.uid == existing().initiatorId || request.auth.uid == existing().answererId) &&
            incoming().status == 'ended' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;

      // Subcollection: Initiator ICE Candidates (Only initiator can create; both participants can read)
      match /initiatorCandidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(candidateId) && (
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.initiatorId == request.auth.uid ||
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.answererId == request.auth.uid
        );

        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.initiatorId == request.auth.uid ||
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.answererId == request.auth.uid
        );

        allow create: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(candidateId) &&
          isValidIceCandidate(incoming(), sessionId, candidateId) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.status != 'ended' &&
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.initiatorId == request.auth.uid;

        allow update, delete: if false;
      }

      // Subcollection: Answerer ICE Candidates (Only answerer can create; both participants can read)
      match /answererCandidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(candidateId) && (
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.initiatorId == request.auth.uid ||
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.answererId == request.auth.uid
        );

        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.initiatorId == request.auth.uid ||
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.answererId == request.auth.uid
        );

        allow create: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(candidateId) &&
          isValidIceCandidate(incoming(), sessionId, candidateId) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.status != 'ended' &&
          get(/databases/$(database)/documents/videoSessions/$(sessionId)).data.answererId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // 10. Collection Rules: /blocks/{blockId}
    match /blocks/{blockId} {
      allow get: if isSignedIn() && isValidBlockId(blockId) && existing().blockerId == request.auth.uid;

      allow list: if isSignedIn() && resource.data.blockerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidBlockId(blockId) &&
        isValidBlock(incoming(), blockId) &&
        incoming().blockerId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow delete: if isSignedIn() && isValidBlockId(blockId) && existing().blockerId == request.auth.uid;

      allow update: if false;
    }

    // 11. Collection Rules: /reports/{reportId}
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().reporterId == request.auth.uid;

      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(reportId) &&
        isValidReport(incoming(), reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // 12. Collection Rules: /subscriptions/{userId}
    match /subscriptions/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);

      allow list, create, update, delete: if false;
    }
  }
}
