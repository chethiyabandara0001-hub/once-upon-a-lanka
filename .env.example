# ==============================================================================
# ONCE UPON A TIME (OUAT) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# SAFE DEVELOPMENT DEFAULTS:
# This file provides defaults that allow testing and developing 100% free of charge.
# Optional third-party paid services (PayHere, Cloudflare TURN) default to empty,
# activating free development mode automatically with zero startup crashes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production: Full public URL injected by your cloud host (e.g., https://onceuponatime.lk)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SERVER SESSION & AUTHENTICATION [MANDATORY FOR PRODUCTION]
# ------------------------------------------------------------------------------
# Used for HMAC signing of user session cookies.
# - In development: If left blank or unset, the server automatically generates a
#   cryptographically secure 256-bit random secret in-memory.
# - In production: REQUIRED. Must be set to a static, high-entropy secret string
#   (e.g., generated with: openssl rand -hex 32).
SESSION_SECRET="ouat_dev_session_secret_replace_with_openssl_rand_in_production_2026"

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT TEST MODE
# ------------------------------------------------------------------------------
# Enables the free 30-day development test membership pass for testing paid features
# (random video/text chat, unlimited discovers, direct messaging) without real payments.
# - In development (NODE_ENV !== 'production'): Enabled by default.
# - In production: STRICTLY FORBIDDEN and disabled by default. If you ever need to
#   allow internal QA testers to use test memberships on a staging server, explicitly set:
ENABLE_DEV_TEST_MODE="false"

# ------------------------------------------------------------------------------
# 4. PAYHERE GATEWAY (SRI LANKA LKR 500.00 MEMBERSHIP) [OPTIONAL IN DEV]
# ------------------------------------------------------------------------------
# If left blank, the app operates in free development mode: real checkouts are
# disabled, and the UI displays "Payments coming soon".
# - To test with PayHere Sandbox: supply your PayHere Sandbox Merchant ID and Secret.
# - For production: Set real merchant credentials and PAYHERE_SANDBOX="false".
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"

# ------------------------------------------------------------------------------
# 5. WEBRTC STUN & CLOUDFLARE TURN RELAY [OPTIONAL IN DEV]
# ------------------------------------------------------------------------------
# The app uses free public STUN servers by default for direct peer-to-peer WebRTC:
VITE_STUN_SERVERS="stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302"

# Cloudflare Calls / TURN credentials:
# - In development: OPTIONAL. Direct P2P connects via STUN across open NATs.
#   If NAT traversal fails without TURN, the UI displays an explicit connection
#   notice while preserving real-time text chat.
# - In production: Recommended to handle symmetric NAT and mobile network firewalls.
TURN_KEY_ID=""
TURN_API_TOKEN=""

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE TURNSTILE (CAPTCHA / ANTI-BOT VERIFICATION)
# ------------------------------------------------------------------------------
# Official Cloudflare Turnstile Test Keys (Free for development, always pass):
# Sitekey:   1x00000000000000000000AA
# Secret:    1x0000000000000000000000000000000AA
# In production, replace with your Cloudflare dashboard keys.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
